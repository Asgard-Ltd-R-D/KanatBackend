# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Ignoring JetBrains folder
.idea

#Ignoring lock files
*.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb


*.log


.env.*
!.env.example

.DS_Store

#Ignoring Python cache files and YOLO cache files

# Ignore model weights and checkpoints
*.pt
*.onnx
*.tflite
*.pb
*.engine

# Ignore training output
runs/
runs*/  # In case there are nested run folders

# Ignore cache files
*.cache
*.npy
*.npz
*.pkl

# Ignore dataset downloads
datasets/
data/**/images/
data/**/labels/

# Keep data.yaml and class files (DO NOT ignore)
!data.yaml
!**/classes.txt

# Ignore models or weights directory if you're storing them separately
trained_models/
weights/

# VSCode and system junk
.vscode/
__pycache__/