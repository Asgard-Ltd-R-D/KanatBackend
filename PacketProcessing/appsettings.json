{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "PacketProcessing.Services.Networking": "Information",
      "PacketProcessing.Utils.Parsers": "Information"
    }
  },

  "Concurrency": {
    "SingleReader": false,
    "SingleWriter": false,
    "MinWorkers": 4,
    "MaxWorkers": 16,
    "BatchSize": 100,
    "BatchTimeoutMs": 15
  },

  "DataPipes": {
    "MotionCapture": {
      "Channel": {
        "Members": 1000000
      },
      "Network": {
        "Device": "any",
        "Protocol": "tcp",
        "IPs": ["132.8.7.125"]
      },
      "Sampling": {
        "IntervalMs": 30
      }
    },

    "SafetyCapture": {
      "Channel": {
        "Members": 1000000
      },
      "Network": {
        "Device": "any",
        "Protocol": "udp",
        "IPs": ["132.8.7.101", "132.8.7.102"]
      },
      "Sampling": {
        "IntervalMs": 30
      }
    },

    "OnVIFCapture": {
      "Channel": {
        "Members": 100000
      },
      "Network": {
        "Device": "any",
        "Protocol": "tcp",
        "IPs": ["132.8.7.121"]
      },
      "Sampling": {
        "IntervalMs": 30
      }
    },

    "WeatherCapture": {
      "Channel": {
        "Members": 1000
      },
      "Network": {
        "Device": "any",
        "Protocol": "udp",
        "IPs": ["132.8.7.103"]
      }
    }
  }
}
