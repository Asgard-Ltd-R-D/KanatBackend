{
  "Application": {
    "Url": "http://0.0.0.0:10900"
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Database": {
    "Host": "localhost",
    "Port": 9000,
    "Username": "quest",
    "Password": "quest",
    "Organization": "my-org",
    "Bucket": "packets",
    "BatchSize": 1000,
    "BatchTimeoutMs": 30
  },

  "Channels": {
    "Capacity": 200000,
    "SingleReader": false,
    "SingleWriter": false
  },

  "Workers": {
    "MinWorkers": 3,
    "MaxWorkers": 8
  },

  "Sniffers": {
    "Pipelines": [
      {
        "Name": "MotionSniffer",
        "Device": "any",
        "Filter": "udp"
      }
    ]
  }
}
