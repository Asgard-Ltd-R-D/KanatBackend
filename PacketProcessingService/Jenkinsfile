pipeline {
    agent any

    environment {
        WORKDIR = "PacketProcessingService/tests"
        DOTNET_ROOT = "${env.HOME}/dotnet"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup .NET 8') {
            steps {
                sh """
                echo 'Installing .NET 8 using dotnet-install script...'
                curl -sSL https://dot.net/v1/dotnet-install.sh -o dotnet-install.sh
                chmod +x dotnet-install.sh

                ./dotnet-install.sh --channel 8.0 --install-dir \$HOME/dotnet

                # Show installed version
                \$HOME/dotnet/dotnet --version
                """
            }
        }

        stage('Restore Dependencies') {
            steps {
                dir(WORKDIR) {
                    sh """
                    export PATH=\$HOME/dotnet:\$PATH
                    dotnet restore PacketProcessingService.Tests.csproj
                    """
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir(WORKDIR) {
                    sh """
                    export PATH=\$HOME/dotnet:\$PATH
                    echo "Running tests for branch ${env.BRANCH_NAME}..."
                    dotnet test PacketProcessingService.Tests.csproj \
                        --configuration Release \
                        --verbosity normal | tee test-log.txt
                    """
                }
            }
        }

        stage('Rename Log File (sanitize branch name)') {
            steps {
                script {
                    def safe = env.BRANCH_NAME.replaceAll(/[\\/*:]/, '-')
                    env.SAFE_BRANCH = safe
                    sh """
                    mv ${WORKDIR}/test-log.txt ${WORKDIR}/test-log-${safe}.txt
                    echo "Sanitized branch name: ${safe}"
                    """
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "${WORKDIR}/test-log-*.txt", fingerprint: true
        }
    }
}
