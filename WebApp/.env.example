# Copy to .env (not committed) and fill in: docker compose reads it.
# The range PC (docker compose --profile app); leave out while developing.
# The log folder, also in the app's kanat-config.json logDir:
#   KANAT_LOG_DIR=C:\ProgramData\Kanat\logs
# VideoService, beside MediaMTX (default: ../VideoService):
#   KANAT_VIDEO_DIR=C:\Kanat\VideoService
# MediaMTX on Windows starts the camera recorders with PowerShell:
#   RECORD_LAUNCHER=powershell
# The PC's time zone, as MediaMTX names its recordings (default: Asia/Jerusalem):
#   KANAT_TZ=Asia/Jerusalem
# The images' tag, as built for this release (default: dev):
#   KANAT_VERSION=1.0.0
